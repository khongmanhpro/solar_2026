generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SolarSystemType {
  GRID_TIED
  HYBRID
}

enum DaytimeUsageLevel {
  LOW
  MEDIUM
  HIGH
}

enum ElectricityType {
  RESIDENTIAL
}

enum DataStatus {
  DEMO
  DRAFT
  VERIFIED
  EXPIRED
  DISABLED
}

enum LeadStatus {
  NEW
  CONTACTED
  SURVEY_SCHEDULED
  QUOTED
  WON
  LOST
}

model SolarPackage {
  id                       String          @id @default(cuid())
  code                     String          @unique
  name                     String
  description              String
  priceVnd                 Int
  capacityKwp              Float
  baseMonthlyGenerationKwh Float
  requiredRoofAreaM2       Float
  systemType               SolarSystemType
  batteryCapacityKwh       Float           @default(0)
  equipmentSummary         String
  panelBrand               String
  panelModel               String
  inverterBrand            String
  inverterModel            String
  panelWarrantyYears       Int
  inverterWarrantyYears    Int
  active                   Boolean         @default(true)
  displayOrder             Int
  dataStatus               DataStatus      @default(DEMO)
  dataVersion              String          @default("demo-package-catalog-2026-07-20")
  sourceReference          String?
  dataOwner                String?
  effectiveFrom            DateTime?
  effectiveTo              DateTime?
  approvedBy               String?
  approvedAt               DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  calculations             Calculation[]

  @@index([active, displayOrder])
}

model CalculationSetting {
  id                               String     @id
  averageElectricityPriceVndPerKwh Int
  batteryRoundTripEfficiency       Float
  batteryDailyCycleFactor          Float
  lowEstimateFactor                Float
  highEstimateFactor               Float
  systemLifetimeYears              Int
  maintenanceRatePerYear           Float
  daytimeLowRatio                  Float
  daytimeMediumRatio               Float
  daytimeHighRatio                 Float
  zaloUrl                          String
  hotline                          String
  businessName                     String
  dataStatus                       DataStatus @default(DEMO)
  dataVersion                      String     @default("demo-calculation-assumptions-2026-07-20")
  sourceReference                  String?
  dataOwner                        String?
  effectiveFrom                    DateTime?
  effectiveTo                      DateTime?
  approvedBy                       String?
  approvedAt                       DateTime?
  createdAt                        DateTime   @default(now())
  updatedAt                        DateTime   @updatedAt
}

model ProvinceFactor {
  id              String     @id @default(cuid())
  code            String     @unique
  name            String
  factor          Float
  active          Boolean    @default(true)
  displayOrder    Int
  dataStatus      DataStatus @default(DEMO)
  dataVersion     String     @default("demo-province-factors-2026-07-20")
  sourceReference String?
  dataOwner       String?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([active, displayOrder])
}

model Calculation {
  id                              String            @id @default(cuid())
  inputContractVersion            String            @default("legacy-v1")
  energyInputSource               String            @default("legacy_money")
  reportedAmountVnd               Int?
  reportedAmountBasis             String?
  normalizedMonthlyConsumptionKwh Float?
  consumptionLowerKwh             Float?
  consumptionUpperKwh             Float?
  inputMonthCount                 Int               @default(1)
  monthlyBill                     Int
  electricityType                 ElectricityType   @default(RESIDENTIAL)
  province                        String
  daytimeUsageLevel               DaytimeUsageLevel
  roofAreaKnown                   Boolean           @default(true)
  roofAreaM2                      Float?
  backupRequired                  Boolean
  essentialLoadWatts              Int?
  backupHours                     Float?
  recommendedPackageId            String?
  recommendedPackage              SolarPackage?     @relation(fields: [recommendedPackageId], references: [id], onDelete: SetNull)
  resultJson                      Json
  snapshotSchemaVersion           String            @default("legacy-v1")
  algorithmVersion                String            @default("legacy-unknown")
  algorithmFingerprint            String            @default("legacy-unknown")
  dataVersion                     String            @default("legacy-unknown")
  dataVersions                    Json?
  dataStatus                      DataStatus        @default(DEMO)
  createdAt                       DateTime          @default(now())
  leads                           Lead[]

  @@index([createdAt])
  @@index([recommendedPackageId])
  @@index([dataStatus, createdAt])
}

model Lead {
  id                   String      @id @default(cuid())
  fullName             String
  phone                String
  address              String?
  preferredContactTime String
  note                 String?
  status               LeadStatus  @default(NEW)
  calculationId        String
  calculation          Calculation @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([calculationId])
}
