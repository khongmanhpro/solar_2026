generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SolarSystemType {
  GRID_TIED
  HYBRID
}

enum DaytimeUsageLevel {
  LOW
  MEDIUM
  HIGH
}

enum ElectricityType {
  RESIDENTIAL
}

enum LeadStatus {
  NEW
  CONTACTED
  SURVEY_SCHEDULED
  QUOTED
  WON
  LOST
}

model SolarPackage {
  id                       String          @id @default(cuid())
  code                     String          @unique
  name                     String
  description              String
  priceVnd                 Int
  capacityKwp              Float
  baseMonthlyGenerationKwh Float
  requiredRoofAreaM2       Float
  systemType               SolarSystemType
  batteryCapacityKwh       Float           @default(0)
  equipmentSummary         String
  panelBrand               String
  panelModel               String
  inverterBrand            String
  inverterModel            String
  panelWarrantyYears       Int
  inverterWarrantyYears    Int
  active                   Boolean         @default(true)
  displayOrder             Int
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  calculations             Calculation[]

  @@index([active, displayOrder])
}

model CalculationSetting {
  id                               String   @id
  averageElectricityPriceVndPerKwh Int
  batteryRoundTripEfficiency       Float
  batteryDailyCycleFactor          Float
  lowEstimateFactor                Float
  highEstimateFactor               Float
  systemLifetimeYears              Int
  maintenanceRatePerYear           Float
  daytimeLowRatio                  Float
  daytimeMediumRatio               Float
  daytimeHighRatio                 Float
  zaloUrl                          String
  hotline                          String
  businessName                     String
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt
}

model ProvinceFactor {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  factor       Float
  active       Boolean  @default(true)
  displayOrder Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder])
}

model Calculation {
  id                   String            @id @default(cuid())
  monthlyBill          Int
  electricityType      ElectricityType   @default(RESIDENTIAL)
  province             String
  daytimeUsageLevel    DaytimeUsageLevel
  roofAreaM2           Float
  backupRequired       Boolean
  recommendedPackageId String?
  recommendedPackage   SolarPackage?     @relation(fields: [recommendedPackageId], references: [id], onDelete: SetNull)
  resultJson           Json
  createdAt            DateTime          @default(now())
  leads                Lead[]

  @@index([createdAt])
  @@index([recommendedPackageId])
}

model Lead {
  id                   String      @id @default(cuid())
  fullName             String
  phone                String
  address              String?
  preferredContactTime String
  note                 String?
  status               LeadStatus  @default(NEW)
  calculationId        String
  calculation          Calculation @relation(fields: [calculationId], references: [id], onDelete: Restrict)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([status, createdAt])
  @@index([calculationId])
}
